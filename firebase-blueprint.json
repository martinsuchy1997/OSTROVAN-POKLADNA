{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Fotbalový hráč na soupisce týmu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "jerseyNumber": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Záznam o udělené pokutě hráči",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "amount", "type", "date", "category", "createdAt"]
    },
    "TreasurySettings": {
      "title": "TreasurySettings",
      "description": "Nastavení týmové kasy a klubu",
      "type": "object",
      "properties": {
        "teamName": { "type": "string" },
        "currency": { "type": "string" },
        "bankAccount": { "type": "string" }
      },
      "required": ["teamName", "currency"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Položka sazebníku pokut",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Kolekce registrovaných hráčů týmu"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Kolekce udělených pokut"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/TreasurySettings" },
      "description": "Globální konfigurace kasy"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryItem" },
      "description": "Položky sazebníku pokut"
    }
  }
}
